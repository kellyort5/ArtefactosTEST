{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/contracts/v2/notification-status-request.schema.json",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]{1,64}(?![\\s\\S])"
    }
  },
  "required": [
    "device_id"
  ],
  "additionalProperties": false
}
