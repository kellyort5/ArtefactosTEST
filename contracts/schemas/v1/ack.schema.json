{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/contracts/v1/ack.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "const": "ack"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "boot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,12})?Z$",
          "maxLength": 32
        },
        {
          "type": "null"
        }
      ]
    },
    "time_quality": {
      "enum": [
        "unknown",
        "app_sync",
        "network_sync"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "status": {
          "enum": [
            "accepted",
            "applied",
            "rejected"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "error": {
          "enum": [
            null,
            "invalid_message",
            "unsupported_version",
            "unauthorized",
            "wrong_boot",
            "expired",
            "revision_conflict",
            "busy",
            "id_conflict",
            "not_implemented",
            "resource_error"
          ]
        },
        "result": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "next_cursor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "retained_from": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "retained_to": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "more": {
                  "type": "boolean"
                },
                "gap": {
                  "type": "boolean"
                }
              },
              "required": [
                "next_cursor",
                "retained_from",
                "retained_to",
                "more",
                "gap"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "command_id",
        "status",
        "revision",
        "error",
        "result"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "enum": [
                  "invalid_message",
                  "unsupported_version",
                  "unauthorized",
                  "wrong_boot",
                  "expired",
                  "revision_conflict",
                  "busy",
                  "id_conflict",
                  "not_implemented",
                  "resource_error"
                ]
              },
              "result": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "version",
    "type",
    "device_id",
    "boot_id",
    "message_id",
    "seq",
    "uptime_ms",
    "timestamp",
    "time_quality",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "time_quality": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "timestamp": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,12})?Z$",
            "maxLength": 32
          }
        }
      }
    }
  ]
}
