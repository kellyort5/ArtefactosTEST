{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/contracts/v1/event.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "const": "event"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "boot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,12})?Z$",
          "maxLength": 32
        },
        {
          "type": "null"
        }
      ]
    },
    "time_quality": {
      "enum": [
        "unknown",
        "app_sync",
        "network_sync"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "journal_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "enum": [
            "system.booted",
            "system.profile_changed",
            "system.error"
          ]
        },
        "profile": {
          "enum": [
            "idle",
            "escudo",
            "cebo"
          ]
        },
        "code": {
          "enum": [
            null,
            "invalid_message",
            "unsupported_version",
            "unauthorized",
            "wrong_boot",
            "expired",
            "revision_conflict",
            "busy",
            "id_conflict",
            "not_implemented",
            "resource_error"
          ]
        }
      },
      "required": [
        "journal_seq",
        "name",
        "profile",
        "code"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "type",
    "device_id",
    "boot_id",
    "message_id",
    "seq",
    "uptime_ms",
    "timestamp",
    "time_quality",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "time_quality": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "timestamp": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,12})?Z$",
            "maxLength": 32
          }
        }
      }
    }
  ]
}
