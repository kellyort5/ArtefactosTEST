{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/contracts/v1/metadata.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "boot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "max_message_bytes": {
      "const": 2048
    }
  },
  "required": [
    "version",
    "device_id",
    "boot_id",
    "revision",
    "uptime_ms",
    "max_message_bytes"
  ],
  "additionalProperties": false
}
